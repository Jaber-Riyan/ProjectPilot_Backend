# Server Configuration
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000

# Database Configuration (Neon PostgreSQL)
# -----------------------------------------------------------------------------------------
# DATABASE_URL: Neon Pooled Connection URL (used by the application runtime via @prisma/adapter-neon)
# How to obtain: Neon Dashboard -> Project -> Connection Details -> Toggle ON "Pooled connection"
DATABASE_URL=postgresql://user:password@ep-sample-123456-pooler.us-east-2.aws.neon.tech/projectpilot?sslmode=require

# DIRECT_URL: Neon Direct Connection URL (used by Prisma CLI for migrations and schema introspection)
# How to obtain: Neon Dashboard -> Project -> Connection Details -> Toggle OFF "Pooled connection"
DIRECT_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/projectpilot?sslmode=require

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=120000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_CLEANUP_BATCH_SIZE=1000

# Authentication & JWT Configuration
# -----------------------------------------------------------------------------------------
# JWT_SECRET: Secret key used to sign and verify HMAC SHA-256 (HS256) access tokens (minimum 32 characters required in production)
JWT_SECRET=projectpilot_jwt_dev_secret_key_32_characters_minimum!
# JWT_EXPIRES_IN: Lifespan for JWT access tokens (e.g., 15m, 1h, 7d)
JWT_EXPIRES_IN=15m

# Initial Seeding Configuration
# -----------------------------------------------------------------------------------------
# Used by `npm run db:seed` to provision initial default mentor and administrator accounts idempotently
SEED_MENTOR_EMAIL=mentor@projectpilot.dev
SEED_MENTOR_PASSWORD=MentorSecret2026!
SEED_ADMIN_EMAIL=admin@projectpilot.dev
SEED_ADMIN_PASSWORD=AdminSecret2026!
