enum Role {
  STUDENT
  MENTOR
  ADMIN
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  submissions         Submission[] @relation("StudentSubmissions")
  reviewedSubmissions Submission[] @relation("MentorReviews")
  feedbacks           Feedback[]   @relation("MentorFeedback")
  coursesCreated      Course[]     @relation("CourseCreator")
  modulesCreated      Module[]     @relation("ModuleCreator")
  assignmentsCreated  Assignment[] @relation("AssignmentCreator")

  @@index([role])
  @@index([email])
  @@map("users")
}
