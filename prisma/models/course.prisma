model Course {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  slug        String   @unique
  description String?  @db.Text
  imageUrl    String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  modules Module[]

  @@index([isPublished])
  @@map("courses")
}
