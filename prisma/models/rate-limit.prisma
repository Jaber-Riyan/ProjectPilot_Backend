model RateLimitEntry {
  id              String   @id @default(uuid()) @db.Uuid
  key             String   @unique
  count           Int      @default(1)
  windowStartedAt DateTime @default(now())
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([expiresAt])
  @@map("rate_limit_entries")
}
